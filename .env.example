# cp .env.example .env && chmod 600 .env
# Значения сгенерировать:  python manage.py gen-keys

# подпись cookie-сессий (>= 32 символов)
SECRET_KEY=
# ключ шифрования паролей рабочих мест в БД. Потеряете ключ — данные не восстановить,
# храните копию отдельно от бэкапа БД
ENCRYPTION_KEY=

# за reverse-proxy с HTTPS: TRUST_PROXY=1 и COOKIE_SECURE=1
# TRUST_PROXY=0
# COOKIE_SECURE=0

# PENDING_TTL_MIN=30        # через сколько минут протухают неактивированные коды
# MAX_PENDING=1000          # потолок неактивированных кодов; при превышении удаляются самые старые
# UI_TZ_OFFSET_HOURS=7      # часовой пояс для отображения времени (НСК = 7)
# MIN_PASSWORD_LEN=10      # минимальная длина пароля администратора
